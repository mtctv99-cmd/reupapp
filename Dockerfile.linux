FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv python3-dev python3-pip python3-gi python3-gi-cairo \
    gir1.2-gtk-3.0 gir1.2-webkit2-4.1 libwebkit2gtk-4.1-0 \
    ffmpeg libsndfile1 libgomp1 libgl1 libglib2.0-0 libsm6 libxrender1 libxext6 \
    libcairo2-dev pkg-config gobject-introspection libgirepository1.0-dev \
    ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1
WORKDIR /src
RUN python3 -m venv --system-site-packages /opt/sever-venv
ENV PATH="/opt/sever-venv/bin:$PATH"
COPY requirements.txt /tmp/requirements.txt
RUN pip install --upgrade pip setuptools wheel \
    && pip install PyGObject pyinstaller \
    && pip install -r /tmp/requirements.txt \
    && playwright install chromium
CMD ["bash"]
